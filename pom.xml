<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.18</version>
        <relativePath/>
    </parent>

    <groupId>com.hospital</groupId>
    <artifactId>hospital-management-system</artifactId>
    <version>1.0.0</version>
    <name>hospital-management-system</name>
    <description>智慧医院管理系统 - 基于AJAX技术的多层架构软件开发</description>

    <properties>
        <java.version>21</java.version>
        <mybatis-plus.version>3.5.3.1</mybatis-plus.version>
        <jwt.version>0.11.5</jwt.version>
    </properties>

    <dependencies>
        <!-- ============================================ -->
        <!-- Spring Boot Web Starter                      -->
        <!-- 提供Web开发所需的核心功能：                   -->
        <!-- - 内嵌Tomcat服务器                           -->
        <!-- - Spring MVC框架                             -->
        <!-- - RESTful API支持                            -->
        <!-- - JSON序列化/反序列化                        -->
        <!-- ============================================ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- ============================================ -->
        <!-- Spring Boot Security Starter                 -->
        <!-- 提供安全认证和授权功能：                      -->
        <!-- - 用户身份验证                               -->
        <!-- - 访问控制                                   -->
        <!-- - CSRF防护                                   -->
        <!-- - 密码加密                                   -->
        <!-- ============================================ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- ============================================ -->
        <!-- MyBatis Plus Starter                         -->
        <!-- MyBatis增强工具，简化数据库操作：             -->
        <!-- - 通用CRUD操作                               -->
        <!-- - 分页插件                                   -->
        <!-- - 条件构造器                                 -->
        <!-- - 代码生成器                                 -->
        <!-- ============================================ -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-boot-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <!-- ============================================ -->
        <!-- MariaDB JDBC驱动                             -->
        <!-- 用于连接MariaDB/MySQL数据库：                 -->
        <!-- - 兼容MySQL协议                              -->
        <!-- - 运行时依赖                                 -->
        <!-- ============================================ -->
        <dependency>
            <groupId>org.mariadb.jdbc</groupId>
            <artifactId>mariadb-java-client</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ============================================ -->
        <!-- JWT (JSON Web Token) - API接口              -->
        <!-- 用于无状态身份认证：                          -->
        <!-- - Token生成                                  -->
        <!-- - Token解析                                  -->
        <!-- - 用户信息存储                               -->
        <!-- ============================================ -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jwt.version}</version>
        </dependency>

        <!-- ============================================ -->
        <!-- JWT 实现模块（运行时依赖）                    -->
        <!-- 提供JWT的核心实现逻辑                         -->
        <!-- ============================================ -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- ============================================ -->
        <!-- JWT Jackson集成（运行时依赖）                 -->
        <!-- 用于JSON数据的序列化处理                      -->
        <!-- ============================================ -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- ============================================ -->
        <!-- Spring Boot Validation Starter               -->
        <!-- 提供数据校验功能：                            -->
        <!-- - @Valid注解支持                             -->
        <!-- - 表单验证                                   -->
        <!-- - 参数校验                                   -->
        <!-- ============================================ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ============================================ -->
        <!-- Lombok                                       -->
        <!-- 简化Java代码的工具：                          -->
        <!-- - @Data自动生成getter/setter                  -->
        <!-- - @Slf4j自动生成日志对象                     -->
        <!-- - 减少样板代码                               -->
        <!-- optional=true表示不会传递给依赖此项目的模块   -->
        <!-- ============================================ -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ============================================ -->
        <!-- Spring Boot Test Starter                     -->
        <!-- 提供测试所需的全部依赖：                      -->
        <!-- - JUnit 5                                    -->
        <!-- - Mockito                                    -->
        <!-- - Spring Test                                -->
        <!-- - AssertJ                                    -->
        <!-- scope=test表示仅在测试阶段使用               -->
        <!-- ============================================ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ============================================ -->
        <!-- Spring Security Test                         -->
        <!-- 提供Spring Security的测试支持：               -->
        <!-- - 模拟认证用户                               -->
        <!-- - 测试安全配置                               -->
        <!-- scope=test表示仅在测试阶段使用               -->
        <!-- ============================================ -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
    </dependencies>

    <!-- ============================================ -->
    <!-- 构建配置                                      -->
    <!-- 定义Maven构建过程中的插件配置                  -->
    <!-- ============================================ -->
    <build>
        <plugins>
            <!-- ============================================ -->
            <!-- Spring Boot Maven Plugin                     -->
            <!-- Spring Boot官方Maven插件，提供以下功能：      -->
            <!-- - 打包成可执行的JAR文件                       -->
            <!-- - 运行Spring Boot应用（mvn spring-boot:run） -->
            <!-- - 重新打包以包含所有依赖                      -->
            <!-- - 构建信息生成                               -->
            <!-- excludes配置：排除Lombok，避免打入最终包中   -->
            <!-- ============================================ -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
